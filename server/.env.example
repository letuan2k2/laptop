# Sao chép file này thành server/.env rồi điền giá trị thật

# Kết nối MySQL (XAMPP): mysql://user:mật_khẩu@host:cổng/tên_database
DATABASE_URL="mysql://root:@localhost:3306/laptop_db"

# Chuỗi bí mật để ký JWT đăng nhập – đặt chuỗi ngẫu nhiên dài (VD: chạy `openssl rand -base64 32`)
AUTH_SECRET="doi-thanh-chuoi-ngau-nhien-dai"

# Cổng của server Express (mặc định 4000)
PORT=4000

# Gmail gửi mã OTP quên mật khẩu (dùng App Password, không phải mật khẩu Gmail)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Chỉ cần khi deploy frontend React ở tên miền khác server (cách nhau bởi dấu phẩy)
# CLIENT_ORIGIN="https://lapstore.vn"
