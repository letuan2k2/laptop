generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  role         Role     @default(USER)
  name         String
  email        String   @unique
  passwordHash String
  phoneNumber  String?
  address      String?
  points       Int      @default(0)
  rank         Rank     @default(BRONZE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password Reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  orders        Order[]
  conversations Conversation[]
  favorites     Favorite[]
  reviews       Review[]
  reviewReplies ReviewReply[]
  addresses     UserAddress[]
  notifications Notification[]
  privateNotes  PrivateNote[]
  feedbacks     Feedback[]

  @@map("user")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("category")
}

model Product {
  id            String    @id @default(uuid())
  sku           String    @unique
  name          String
  brand         String
  price         Decimal   @db.Decimal(15, 2)
  originalPrice Decimal?  @db.Decimal(15, 2) // Giá niêm yết, dùng để hiển thị % giảm
  stockQuantity Int       @default(0)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Thông số kỹ thuật
  cpu            String
  ram            String
  ramGb          Int
  storage        String
  storageGb      Int
  gpu            String
  display        String
  battery        String?
  weight         String?
  os             String?
  ports          String? @db.Text
  connectivity   String?
  color          String?
  warrantyMonths Int     @default(12)

  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
  description String?  @db.Text
  imageUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
  favorites     Favorite[]
  conversations Conversation[]
  priceHistory  PriceHistory[]
  privateNotes  PrivateNote[]
  vouchers      Voucher[]      @relation("ProductVouchers")

  @@index([brand])
  @@index([categoryId])
  @@map("product")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  price     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("pricehistory")
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  subTotal        Decimal       @db.Decimal(15, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(15, 2)
  shippingFee     Decimal       @default(0.00) @db.Decimal(15, 2)
  totalPayment    Decimal       @db.Decimal(15, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  status          OrderStatus   @default(PENDING)
  voucherId       String?
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  note            String?       @db.Text
  trackingCode    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  voucher Voucher?    @relation(fields: [voucherId], references: [id])
  items   OrderItem[]
  reviews Review[]

  @@index([userId])
  @@index([status])
  @@map("order")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("orderitem")
}

model Review {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  userId    String
  rating    Int      @default(5)
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  replies ReviewReply[]

  @@unique([orderId, productId])
  @@index([productId])
  @@map("review")
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@map("reviewreply")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorite")
}

model PrivateNote {
  id        String   @id @default(uuid())
  userId    String
  productId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("privatenote")
}

// Hội thoại hỗ trợ giữa khách hàng và cửa hàng (admin trả lời)
model Conversation {
  id          String   @id @default(uuid())
  userId      String
  productId   String?
  lastMessage String?  @db.Text
  lastMsgAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@map("conversation")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("message")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification")
}

model Voucher {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String?
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(15, 2)
  minOrderAmount Decimal      @default(0.00) @db.Decimal(15, 2)
  maxDiscount    Decimal?     @db.Decimal(15, 2)
  expiryDate     DateTime?
  usageLimit     Int          @default(100)
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  minRank        Rank         @default(BRONZE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders   Order[]
  // Để trống = áp dụng cho toàn bộ đơn hàng
  products Product[] @relation("ProductVouchers")

  @@map("voucher")
}

// Góp ý / khiếu nại gửi từ trang /gop-y (khách không cần đăng nhập)
model Feedback {
  id        String         @id @default(uuid())
  userId    String?
  name      String
  phone     String
  email     String?
  orderCode String?
  type      FeedbackType   @default(SUGGESTION)
  content   String         @db.Text
  status    FeedbackStatus @default(NEW)
  adminNote String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("feedback")
}

model UserAddress {
  id        String   @id @default(uuid())
  userId    String
  title     String? // Ví dụ: "Nhà riêng", "Cơ quan"
  name      String // Tên người nhận
  phone     String // Số điện thoại nhận hàng
  address   String // Địa chỉ chi tiết
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("useraddress")
}

enum Role {
  ADMIN
  USER

  @@map("user_role")
}

enum PaymentMethod {
  VNPAY
  MOMO
  COD

  @@map("order_paymentMethod")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("order_paymentStatus")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
}

enum Rank {
  BRONZE
  SILVER
  GOLD
  PLATINUM

  @@map("user_rank")
}

enum NotificationType {
  INFO
  ORDER
  PRICE_DROP
  SYSTEM

  @@map("notification_type")
}

enum FeedbackType {
  SUGGESTION
  COMPLAINT
  WARRANTY

  @@map("feedback_type")
}

enum FeedbackStatus {
  NEW
  PROCESSING
  RESOLVED

  @@map("feedback_status")
}
